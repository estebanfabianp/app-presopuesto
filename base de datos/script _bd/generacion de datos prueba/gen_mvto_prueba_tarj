# Simulación de movimientos
movimientos = []
for i in range(50000):  # 50,000 transacciones simuladas
    # Fecha aleatoria dentro del rango
    fecha = fecha_inicio + timedelta(days=random.randint(0, dias))
    descripcion = random.choice(descripciones)
    valor = round(random.uniform(20000, 500000), 2)

    # Definir cuotas: si es compra diferida, asignar cuotas aleatorias
    if descripcion == "COMPRA DIFERIDA":
        cuotas_total = random.choice([3, 6, 12])
        cuota_actual = random.randint(1, cuotas_total)
        cuotas = f"{cuota_actual}/{cuotas_total}"
    else:
        cuotas = "1/1"

    # Número de autorización ficticio
    autorizacion = random.randint(10000, 99999)

    # Agregar movimiento simulado a la lista
    movimientos.append([
        autorizacion,
        fecha.strftime("%Y-%m-%d"),
        descripcion,
        valor,
        random.uniform(0, 0.03),   # tasa pactada (ejemplo)
        random.uniform(0, 0.04),   # tasa facturada
        valor,
        0 if "AJUSTE" not in descripcion else -valor, # ajuste puede ser reverso
        cuotas
    ])

# Crear DataFrame con los movimientos simulados
cols = [
    "Número de Autorización", "Fecha de Transacción", "Descripción",
    "Valor Original", "Tasa Pactada", "Tasa EA Facturada",
    "Cargos y Abonos", "Saldo a Diferir", "Cuotas"
]
df = pd.DataFrame(movimientos, columns=cols)

# Guardar los datos simulados a un archivo CSV
df.to_csv("movimientos_simulados.csv", index=False, sep=";")
